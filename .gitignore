# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/
.venv/
venv/

# Operational artifacts — never commit run evidence or tickets
runs/
runs_test/
*.ccache
*.kirbi
*.keytab

# Local configuration with real credentials (policy.example.yaml is committed;
# your actual lab policy is not)
policy.yaml
lab.yaml
*.local.yaml

# Editor / OS
.idea/
.vscode/
*.swp
Thumbs.db
.DS_Store

# inventory cache + per-run resume state (contain lab file paths + content —
# runs/ is ignored above; these cover non-default --audit-dir locations)
.cache/
inventory.db*
runs/**/run.json
runs/**/state/
